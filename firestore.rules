rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    // Haupt-Admin (fest) und weitere Admins, die der Haupt-Admin unter admins/{email} einträgt
    function isOwner() { return verified() && myEmail() in ['furtschellas@gmail.com']; }
    function isAdmin() {
      return isOwner()
        || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    // Schlüssel für die Crew-Daten: nur für freigeschaltete Mitglieder und Admins
    match /secret/key {
      allow get: if isAdmin() || isMember();
      allow list, write: if false;
    }

    // Weitere Admins: nur der Haupt-Admin verwaltet sie
    match /admins/{email} {
      allow read: if isAdmin();
      allow get: if verified() && myEmail() == email;
      allow write: if isOwner();
    }

    // Einladungen (E-Mail-Adresse = Dokument-ID): verwaltet nur der Admin
    match /invites/{email} {
      allow read, write: if isAdmin();
      allow get: if verified() && myEmail() == email;
    }

    // Mitglieder: wer eingeladen ist, tritt einmal selbst bei; sperren und entfernen kann nur der Haupt-Admin
    match /members/{uid} {
      allow read: if isAdmin();
      allow update, delete: if isOwner();
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isOwner() || (isAdmin() && request.auth.uid == uid) || (verified() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && request.resource.data.keys().hasOnly(['active', 'email', 'name', 'joinedAt', 'firstName', 'lastName', 'lang', 'birthday', 'diet', 'intol', 'allergies'])
        && request.resource.data.active == true
        && request.resource.data.email == myEmail());
      allow update: if verified() && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'firstName', 'lastName', 'lang', 'birthday', 'diet', 'intol', 'allergies'])
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
