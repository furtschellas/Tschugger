rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // bestätigt = E-Mail bestätigt ODER Konto vom Besitzer mit Startpasswort angelegt (starts/{email})
    function verified() { return signedIn() && (request.auth.token.email_verified == true
      || exists(/databases/$(database)/documents/starts/$(request.auth.token.email.lower()))); }
    function myEmail() { return request.auth.token.email.lower(); }
    // Besitzer (fest) und weitere Admins, die der Besitzer unter admins/{email} einträgt
    function isRoot(e) { return e in ['furtschellas@gmail.com']; }
    function ownerEmail(e) { return isRoot(e) || exists(/databases/$(database)/documents/owners/$(e)); }
    function isOwner() { return verified() && ownerEmail(myEmail()); }
    function isAdmin() {
      return isOwner()
        || (verified() && exists(/databases/$(database)/documents/admins/$(myEmail())));
    }
    // Rollen: der Besitzer legt roles/{id} (name, perms) an und weist sie unter userroles/{email} zu.
    // can(p): Besitzer alles; Admins alles ausser 'settings'; sonst die Berechtigungen der eigenen Rolle
    function rolePerms() {
      return get(/databases/$(database)/documents/roles/$(get(/databases/$(database)/documents/userroles/$(myEmail())).data.role)).data.perms;
    }
    // Admin-Rechte: Standard alles ausser 'settings'; der Besitzer kann sie unter roles/admin anpassen
    function adminHas(p) {
      return (!exists(/databases/$(database)/documents/roles/admin) && p != 'settings')
        || (exists(/databases/$(database)/documents/roles/admin) && p in get(/databases/$(database)/documents/roles/admin).data.perms);
    }
    function can(p) {
      return isOwner() || (isAdmin() && adminHas(p))
        || (verified() && exists(/databases/$(database)/documents/userroles/$(myEmail())) && p in rolePerms());
    }
    // Catering: wer eine Rolle hat, deren Kennung «cater» enthält (z. B. catering)
    function isCatering() {
      return verified() && exists(/databases/$(database)/documents/userroles/$(myEmail()))
        && get(/databases/$(database)/documents/userroles/$(myEmail())).data.role.matches('.*cater.*');
    }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    // Schlüssel für die Crew-Daten: nur für freigeschaltete Mitglieder und Admins
    match /secret/key {
      allow get: if isAdmin() || isMember();
      allow list, write: if false;
    }

    // App-Einstellungen (z. B. angebotene Sprachen): alle lesen, nur der Haupt-Admin ändert
    match /config/{doc} {
      allow read: if true;
      allow write: if can('settings') && doc == 'app';
    }

    match /roles/{id} {
      allow read: if signedIn();
      // Rollen anlegen/ändern/löschen: Admins, oder wer «Rollen bearbeiten» hat (nicht die Admin-Rolle)
      allow write: if (isAdmin() || (can('roles.edit') && id != 'admin'))
        && (request.resource == null || (request.resource.data.keys().hasOnly(['name', 'perms', 'at'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.perms is list && request.resource.data.perms.size() <= 40));
    }
    match /userroles/{email} {
      allow get: if (verified() && myEmail() == email) || isAdmin();
      allow list: if isAdmin() || can('roles.assign') || can('roles.edit');
      allow write: if ((isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email))) && email != myEmail()
        && (request.resource == null || request.resource.data.keys().hasOnly(['role', 'at']));
      // «Rollen pflegen»: Rollen zuweisen, aber nicht an Owner oder Admins und nicht sich selbst
      allow write: if can('roles.assign') && email != myEmail() && !ownerEmail(email)
        && !exists(/databases/$(database)/documents/admins/$(email))
        && (request.resource == null || (request.resource.data.keys().hasOnly(['role', 'at']) && request.resource.data.role != 'admin'));
      // wer einladen darf, gibt neuen Benutzer:innen automatisch die Rolle «Crew»
      allow create: if can('users.invite') && !ownerEmail(email)
        && request.resource.data.keys().hasOnly(['role', 'at']) && request.resource.data.role == 'crew';
    }

    // Geburtstagsliste (nur Name + Tag/Monat): jede Person pflegt ihren eigenen Eintrag, der Haupt-Admin gleicht ab;
    // lesen dürfen Admins immer, alle anderen Mitglieder nur, wenn der Haupt-Admin sie freigegeben hat
    match /bdays/{uid} {
      allow read: if can('crew.bday')
        || (isMember() && get(/databases/$(database)/documents/config/app).data.get('bdayPublic', false) == true);
      allow write: if isOwner() || (verified() && request.auth.uid == uid
        && (request.resource == null || request.resource.data.keys().hasOnly(['name', 'md'])));
    }

    // Weitere Admins: nur der Haupt-Admin verwaltet sie
    match /admins/{email} {
      allow read: if isAdmin();
      allow get: if verified() && myEmail() == email;
      allow delete: if (isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email) && email != myEmail());
      allow create, update: if ((isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email))) && email != myEmail()
        && request.resource.data.keys().hasOnly(['addedAt']);
    }

    // Owner: der feste Owner und alle, die ein Owner hier einträgt; nur Owner verwalten Owner
    match /owners/{email} {
      allow read: if isAdmin();
      allow get: if verified() && myEmail() == email;
      allow create, update: if isOwner() && !isRoot(email) && request.resource.data.keys().hasOnly(['addedAt']);
      allow delete: if isOwner() && !isRoot(email);
    }

    // Einladungen (E-Mail-Adresse = Dokument-ID): verwalten alle Admins
    match /invites/{email} {
      allow read: if can('users.view') || can('users.invite') || can('contacts.extra');
      allow delete: if can('users.invite');
      allow create: if (can('users.invite') || can('users.requests')) && request.resource.data.keys().hasOnly(['name', 'role', 'addedAt']);
      allow update: if (can('users.invite') || can('users.edit')) && request.resource.data.keys().hasOnly(['name', 'role', 'addedAt']);
      allow get: if verified() && myEmail() == email;
    }

    // Zugangsanfragen: wer nicht auf der Liste ist, fragt mit der eigenen (bestätigten) Adresse an; alle Admins sehen und erledigen sie
    match /requests/{email} {
      allow create, update: if verified() && myEmail() == email
        && request.resource.data.keys().hasOnly(['name', 'role', 'note', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 280);
      allow get: if (verified() && myEmail() == email) || isAdmin();
      allow list, delete: if can('users.requests');
    }

    // Startpasswort-Konten: nur der Besitzer legt sie an; die Person setzt nach dem ersten Login mustChange auf false
    match /starts/{email} {
      allow get: if isOwner() || (signedIn() && request.auth.token.email.lower() == email);
      allow list, delete: if isOwner();
      allow create: if isOwner() && request.resource.data.keys().hasOnly(['mustChange', 'at']);
      allow update: if isOwner() || (signedIn() && request.auth.token.email.lower() == email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
        && request.resource.data.mustChange == false);
    }

    // Ansichts-Einstellungen pro Benutzer (Thema, Anzeige-Knöpfe, Units): jede Person nur ihre eigenen
    match /prefs/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && request.resource.data.size() <= 12;
    }

    // Mitglieder: wer eingeladen ist, tritt einmal selbst bei; sperren und entfernen kann nur der Haupt-Admin
    match /members/{uid} {
      allow read: if can('users.view') || can('users.edit') || can('crew.food') || can('crew.bday') || can('contacts.extra');
      // der Haupt-Admin selbst kann nicht gesperrt oder gelöscht werden
      allow update, delete: if isOwner() && !isRoot(resource.data.email);
      // alle Admins dürfen die Profildaten der Benutzer:innen ändern (nicht sperren, nicht die E-Mail, nicht das Konto des Besitzers)
      allow update: if can('users.edit') && (isOwner() || !ownerEmail(resource.data.email))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'firstName', 'lastName', 'lang', 'birthday', 'gender', 'phone', 'contactEmail', 'diet', 'intol', 'allergies', 'welcomeAck', 'welcomeVer', 'func']);
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isOwner() || (isAdmin() && request.auth.uid == uid) || (verified() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && request.resource.data.keys().hasOnly(['active', 'email', 'name', 'joinedAt', 'firstName', 'lastName', 'lang', 'birthday', 'gender', 'phone', 'contactEmail', 'diet', 'intol', 'allergies', 'welcomeAck', 'welcomeVer', 'tour', 'tourAt', 'func'])
        && request.resource.data.active == true
        && request.resource.data.email == myEmail());
      allow update: if verified() && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email', 'name', 'firstName', 'lastName', 'lang', 'birthday', 'gender', 'phone', 'contactEmail', 'diet', 'intol', 'allergies', 'welcomeAck', 'welcomeVer', 'lastSeen', 'tour', 'tourAt', 'func'])
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true;
    }

    // Push-Erinnerungen pro Gerät: mit dem Crew-Schlüssel verschlüsselt; die GitHub-Aktion liest sie (ohne Anmeldung) und verschickt fällige
    match /push/{id} {
      allow read: if true;
      allow create, update: if signedIn() && id.matches(request.auth.uid + '_[a-z0-9]{10}')
        && (isMember() || isAdmin())
        && request.resource.data.keys().hasOnly(['c', 'at'])
        && request.resource.data.c is string && request.resource.data.c.size() < 60000;
      allow delete: if signedIn() && id.matches(request.auth.uid + '_[a-z0-9]{10}');
    }

    // Push-Nachrichten an alle (verschlüsselt mit dem Crew-Schlüssel); nur mit Berechtigung «push.send»
    match /broadcasts/{id} {
      allow read: if true;
      allow create: if can('push.send') && request.resource.data.keys().hasOnly(['c', 'at'])
        && request.resource.data.c is string && request.resource.data.c.size() < 4000;
      allow update: if can('push.send') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sent', 'n']);
      allow delete: if isAdmin();
    }

    // Lunch-Menüs pro Drehtag und Unit (Catering mit «Menüs eingeben»)
    match /menus/{date} {
      allow read: if isMember() || isAdmin();
      allow write: if (isAdmin() || isCatering()) && date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && (request.resource == null || (request.resource.data.keys().hasOnly(['u1', 'u2', 'u3', 'u1a', 'u1b', 'u2a', 'u2b', 'u3a', 'u3b', 'tog', 'zw', 'by', 'at'])
          && request.resource.data.get('zw', '').size() <= 300 && request.resource.data.get('u1a', '').size() <= 300 && request.resource.data.get('u1b', '').size() <= 300
          && request.resource.data.get('u2a', '').size() <= 300 && request.resource.data.get('u2b', '').size() <= 300
          && request.resource.data.get('u3a', '').size() <= 300 && request.resource.data.get('u3b', '').size() <= 300));
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
