rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return verified() && myEmail() in ['furtschellas@gmail.com']; }
    function isMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/members/$(request.auth.uid)).data.active == true;
    }

    // Schlüssel für die Crew-Daten: nur für freigeschaltete Mitglieder und Admins
    match /secret/key {
      allow get: if isAdmin() || isMember();
      allow list, write: if false;
    }

    // Einladungen (E-Mail-Adresse = Dokument-ID): verwaltet nur der Admin
    match /invites/{email} {
      allow read, write: if isAdmin();
      allow get: if verified() && myEmail() == email;
    }

    // Mitglieder: wer eingeladen ist, tritt einmal selbst bei; sperren kann nur der Admin
    match /members/{uid} {
      allow read, update, delete: if isAdmin();
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isAdmin() || (verified() && request.auth.uid == uid
        && exists(/databases/$(database)/documents/invites/$(myEmail()))
        && request.resource.data.keys().hasOnly(['active', 'email', 'name', 'joinedAt'])
        && request.resource.data.active == true
        && request.resource.data.email == myEmail());
      allow update: if verified() && request.auth.uid == uid
        && resource.data.active == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['email'])
        && request.resource.data.email == myEmail();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
