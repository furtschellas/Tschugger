rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------- Hilfsfunktionen ----------
    function signedIn() { return request.auth != null; }
    // Pfad zu einem Dokument (statt den langen Pfad überall auszuschreiben)
    function d(col, id) { return /databases/$(database)/documents/$(col)/$(id); }
    // bestätigt = E-Mail bestätigt ODER Konto vom Besitzer mit Startpasswort angelegt (starts/{email})
    function verified() { return signedIn() && (request.auth.token.email_verified == true
      || exists(d('starts', request.auth.token.email.lower()))); }
    function myEmail() { return request.auth.token.email.lower(); }
    // Besitzer (fest) und weitere Admins, die der Besitzer unter admins/{email} einträgt
    function isRoot(e) { return e in ['furtschellas@gmail.com']; }
    function ownerEmail(e) { return isRoot(e) || exists(d('owners', e)); }
    function isOwner() { return verified() && ownerEmail(myEmail()); }
    function isAdmin() {
      return isOwner()
        || (verified() && exists(d('admins', myEmail())));
    }
    // Rollen: der Besitzer legt roles/{id} (name, perms) an und weist sie unter userroles/{email} zu.
    // can(p): Besitzer alles; Admins alles ausser 'settings'; sonst die Berechtigungen der eigenen Rolle
    function hasRole() { return exists(d('userroles', myEmail())); }
    function myRole() { return get(d('userroles', myEmail())).data.role; }
    function rolePerms() { return get(d('roles', myRole())).data.perms; }
    // Admin-Rechte: Standard alles ausser 'settings'; der Besitzer kann sie unter roles/admin anpassen
    function adminHasAny(ps) {
      // ohne roles/admin: alles ausser 'settings'; sonst die dort eingetragenen Berechtigungen
      return exists(d('roles', 'admin')) ? get(d('roles', 'admin')).data.perms.hasAny(ps) : ps.removeAll(['settings']).size() > 0;
    }
    // canAny([..]): mindestens eine der Berechtigungen (eine Liste statt vieler einzelner can(..) || can(..))
    function canAny(ps) {
      return isOwner() || (isAdmin() && adminHasAny(ps))
        || (verified() && hasRole() && isMember() && rolePerms().hasAny(ps));   // gesperrte oder entfernte Personen: keine Rollenrechte mehr
    }
    function can(p) { return canAny([p]); }
    // wer Benutzende oder Rollen sieht (dieselbe Liste an mehreren Stellen)
    function seesUsers() { return isAdmin() || canAny(['users.view', 'users.edit', 'roles.assign', 'roles.edit', 'roles.view']); }
    // Catering: wer eine Rolle hat, deren Kennung «cater» enthält (z. B. catering)
    function isCatering() { return verified() && hasRole() && isMember() && myRole().matches('.*cater.*'); }
    function isMember() {
      return signedIn() && exists(d('members', request.auth.uid)) && get(d('members', request.auth.uid)).data.active == true;
    }
    // Crew = freigeschaltetes Mitglied oder Admin
    function crew() { return isMember() || isAdmin(); }
    // eigenes Gerät (Push): Dokument-ID = uid + '_' + 10 Zeichen
    function ownDevice(id) { return signedIn() && id.matches(request.auth.uid + '_[a-z0-9]{10}'); }
    // verschlüsselter Inhalt c: Text bis zur Grösse max
    function cOk(max) { return request.resource.data.c is string && request.resource.data.c.size() < max; }
    // Felder, die nur aus dieser Liste stammen dürfen (neu) bzw. nur diese ändern (Änderung)
    function only(keys) { return request.resource.data.keys().hasOnly(keys); }
    function changesOnly(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    // Profilfelder der Mitglieder (an mehreren Stellen gleich; testAck/testVer = Willkommen Test-User bestätigt)
    function profile() { return ['name', 'firstName', 'lastName', 'lang', 'birthday', 'gender', 'phone', 'contactEmail', 'diet', 'intol', 'allergies', 'welcomeAck', 'welcomeVer', 'testAck', 'testVer', 'func']; }
    // Menütext höchstens 300 Zeichen
    function short(f) { return request.resource.data.get(f, '').size() <= 300; }
    // Datum als Text JJJJ-MM-TT
    function isDate(v) { return v is string && v.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}'); }
    // Zeitpunkt in Millisekunden, höchstens 1 Stunde neben der Serverzeit (Handys mit falsch gehender Uhr gehen noch)
    function nearNow(v) { return v is int && v > request.time.toMillis() - 3600000 && v < request.time.toMillis() + 3600000; }
    // Fahrt-Dokumente (rideack, rideedit): ID = Prüfsumme der Fahrt (keine Namen), nur diese Felder, Datum d, Zeitpunkt at
    function rideOk(id, keys) { return id.matches('[a-z0-9]{4,16}') && only(keys) && isDate(request.resource.data.d) && nearNow(request.resource.data.at); }

    // ---------- Schlüssel (nur lesen, geschrieben nur vom GitHub-Lauf) ----------
    // Crew-Daten: freigeschaltete Mitglieder und Admins
    match /secret/key {
      allow get: if crew();
      allow list, write: if false;
    }
    // Drehbuch: nur mit «Drehbuch sehen»
    match /secret/keyscript {
      allow get: if crew() && can('view.script');
      allow list, write: if false;
    }
    // Telefon/E-Mail der Crewliste: «Telefonnummern sehen» / «E-Mail-Adressen sehen», ohne Rolle wenn für alle freigegeben
    match /secret/keycontacts {
      allow get: if crew() && (canAny(['view.phone', 'view.email'])
        || (isMember() && !hasRole() && (get(d('config', 'app')).data.get('phonePublic', false) == true
            || get(d('config', 'app')).data.get('emailPublic', false) == true)));
      allow list, write: if false;
    }
    // Google Kalender: geheime iCal-Adresse nur mit «Einstellungen»
    match /secret/gcal {
      allow read, write: if can('settings');
    }

    // ---------- Einstellungen ----------
    // «app» lesen alle (auch vor der Anmeldung), «private» (Links) nur die Crew; ändern nur mit «Einstellungen»
    match /config/{doc} {
      allow read: if doc != 'private' || crew();
      allow write: if can('settings') && (doc == 'app' || doc == 'private');
    }

    // ---------- Personen und Rechte ----------
    // Owner: nur Owner verwalten Owner (der feste Owner bleibt)
    match /owners/{email} {
      allow read: if seesUsers();
      allow get: if verified() && myEmail() == email;
      allow create, update: if isOwner() && !isRoot(email) && only(['addedAt']);
      allow delete: if isOwner() && !isRoot(email);
    }
    // Admins: Owner und Admins verwalten sie, nicht sich selbst und nicht Owner
    match /admins/{email} {
      // die Liste (nur Adressen) sehen auch alle, die Benutzende oder Rollen sehen – sonst erscheinen Admins bei ihnen als «Keine Rolle»
      allow read: if seesUsers();
      allow get: if verified() && myEmail() == email;
      allow delete: if (isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email) && email != myEmail());
      allow create, update: if ((isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email))) && email != myEmail()
        && only(['addedAt']);
    }
    // Rollen: Admins, oder «Rollen bearbeiten» (nicht Admin-Rolle, nicht die eigene, nur eigene Rechte); Admin-Rolle nur der Owner
    match /roles/{id} {
      allow read: if signedIn();
      // Rollen anlegen/ändern/löschen: Admins, oder wer «Rollen bearbeiten» hat (nicht die Admin-Rolle)
      // nicht die eigene Rolle und nur Berechtigungen, die man selbst hat (keine Selbst-Beförderung)
      // die Admin-Rolle (Rechte der Admins) passt nur der Owner an – sonst könnte sich ein Admin selbst «Einstellungen» geben
      allow write: if ((isAdmin() && (id != 'admin' || isOwner())) || (can('roles.edit') && id != 'admin'
          && !(hasRole() && myRole() == id)
          && (request.resource == null || request.resource.data.perms.hasOnly(rolePerms())
              || (resource != null && request.resource.data.perms.hasOnly(rolePerms().concat(resource.data.perms))))))   // vorhandene fremde Rechte bleiben
        && (request.resource == null || (only(['name', 'perms', 'at'])
            && request.resource.data.name is string && request.resource.data.name.size() <= 40
            && request.resource.data.perms is list && request.resource.data.perms.size() <= 80));
    }
    // Rollen zuweisen: Admins, «Rollen pflegen» (nicht an Owner/Admins, nicht sich selbst), Einladende geben «Crew»
    match /userroles/{email} {
      allow get: if (verified() && myEmail() == email) || isAdmin();
      allow list: if isAdmin() || canAny(['roles.assign', 'roles.edit', 'roles.view']);
      allow write: if ((isOwner() && !isRoot(email)) || (isAdmin() && !ownerEmail(email))) && email != myEmail()
        && (request.resource == null || only(['role', 'at']));
      // «Rollen pflegen»: Rollen zuweisen, aber nicht an Owner oder Admins und nicht sich selbst
      allow write: if can('roles.assign') && email != myEmail() && !ownerEmail(email)
        && !exists(d('admins', email))
        && (request.resource == null || (only(['role', 'at']) && request.resource.data.role != 'admin'
          && (isAdmin() || get(d('roles', request.resource.data.role)).data.perms.hasOnly(rolePerms()))));   // nur Rollen mit eigenen Rechten vergeben
      // wer einladen darf, gibt neuen Benutzenden automatisch die Rolle «Crew»
      allow create: if can('users.invite') && !ownerEmail(email)
        && only(['role', 'at']) && request.resource.data.role == 'crew';
    }
    // Einladungen (E-Mail = ID)
    match /invites/{email} {
      allow read: if canAny(['users.view', 'users.invite', 'contacts.extra']);
      allow delete: if can('users.invite');
      allow create: if canAny(['users.invite', 'users.requests']) && only(['name', 'role', 'addedAt']) && email != myEmail();   // niemand lädt sich selbst ein
      allow update: if canAny(['users.invite', 'users.edit']) && only(['name', 'role', 'addedAt']);
      allow get: if verified() && myEmail() == email;
    }
    // Zugangsanfragen: mit der eigenen bestätigten Adresse; erledigt mit «Anfragen»
    match /requests/{email} {
      allow create, update: if verified() && myEmail() == email
        && only(['name', 'role', 'note', 'at'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (!('note' in request.resource.data) || request.resource.data.note.size() <= 280);
      allow get: if (verified() && myEmail() == email) || isAdmin();
      allow list, delete: if can('users.requests');
    }
    // Startpasswort-Konten: der Owner legt sie an, die Person setzt mustChange auf false
    match /starts/{email} {
      allow get: if isOwner() || (signedIn() && request.auth.token.email.lower() == email);
      allow list, delete: if isOwner();
      allow create: if isOwner() && only(['mustChange', 'at']);
      allow update: if isOwner() || (signedIn() && request.auth.token.email.lower() == email
        && changesOnly(['mustChange'])
        && request.resource.data.mustChange == false);
    }
    // Mitglieder: Eingeladene treten selbst bei; sperren/entfernen nur der Owner; Profil ändern sie selbst oder «Benutzende bearbeiten»
    match /members/{uid} {
      allow read: if canAny(['users.view', 'users.edit', 'crew.food', 'crew.bday', 'contacts.extra']);
      // der Haupt-Admin selbst kann nicht gesperrt oder gelöscht werden
      allow update, delete: if isOwner() && !isRoot(resource.data.email);
      // alle Admins dürfen die Profildaten der Benutzenden ändern (nicht sperren, nicht die E-Mail, nicht das Konto des Besitzers)
      allow update: if can('users.edit') && (isOwner() || !ownerEmail(resource.data.email))
        && changesOnly(profile());
      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if isOwner() || (isAdmin() && request.auth.uid == uid) || (verified() && request.auth.uid == uid
        && exists(d('invites', myEmail()))
        && only(profile().concat(['active', 'email', 'joinedAt', 'tour', 'tourAt']))
        && request.resource.data.active == true
        && request.resource.data.email == myEmail());
      allow update: if verified() && request.auth.uid == uid
        && resource.data.active == true
        && changesOnly(profile().concat(['email', 'lastSeen', 'tour', 'tourAt', 'app', 'devs']))
        && (!('app' in request.resource.data) || (request.resource.data.app is string && request.resource.data.app.size() <= 20))
        && (!('devs' in request.resource.data) || (request.resource.data.devs is map && request.resource.data.devs.size() <= 12))
        && request.resource.data.email == myEmail()
        && request.resource.data.active == true;
    }
    // Ansichts-Einstellungen: jede Person nur ihre eigenen
    match /prefs/{uid} {
      allow get, delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid && crew() && request.resource.data.size() <= 16;   // nur Crew
    }
    // Geburtstage (Name, Tag/Monat): eigener Eintrag; lesen mit Recht oder wenn freigegeben
    match /bdays/{uid} {
      allow read: if can('crew.bday')
        || (isMember() && get(d('config', 'app')).data.get('bdayPublic', false) == true);
      allow write: if isOwner() || (verified() && crew() && request.auth.uid == uid   // nur Crew, nur Name und Tag/Monat
        && (request.resource == null || (only(['name', 'md'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 80
          && request.resource.data.md is string && request.resource.data.md.matches('[0-1][0-9]-[0-3][0-9]'))));
    }

    // ---------- Crew-Daten (verschlüsselt mit dem Crew-Schlüssel) ----------
    // Push pro Gerät: eigenes Gerät; Admins sehen den Push-Status
    match /push/{id} {
      allow get: if ownDevice(id);
      allow read: if isAdmin();
      allow create, update: if ownDevice(id) && crew() && only(['c', 'at']) && cOk(60000);
      allow delete: if ownDevice(id);
    }
    // Nachrichten an alle: mit «push.send»
    match /broadcasts/{id} {
      allow read: if isAdmin() || can('push.send');
      allow create: if can('push.send') && only(['c', 'at']) && cOk(4000);
      // der Worker markiert im Namen der sendenden Person: sent (einmalig), n, done (Geräte), fin (alle erledigt)
      allow update: if can('push.send') && changesOnly(['sent', 'n', 'done', 'fin'])
        && (!('done' in request.resource.data) || (request.resource.data.done is list && request.resource.data.done.size() <= 1000));
      allow delete: if isAdmin();
    }
    // Eigene Termine: lesen alle aus der Crew, anlegen mit «Eigene Termine erstellen», ändern/löschen wer ihn angelegt hat und Admins; gc = Google-Kalender-ID
    match /events/{id} {
      allow read: if crew();
      allow create: if (isAdmin() || can('events.add')) && only(['c', 'at', 'by', 'gc'])
        && request.resource.data.by == request.auth.uid && cOk(20000);
      allow update: if ((resource.data.by == request.auth.uid && can('events.add')) || isAdmin())
        && changesOnly(['c']) && cOk(20000);
      allow delete: if resource.data.by == request.auth.uid || isAdmin();
    }
    // Google Kalender: gelesene Termine für «Termine erstellen»; geschrieben nur vom GitHub-Lauf
    match /gcal/{doc} {
      allow read: if isAdmin() || can('events.add');
      allow write: if false;
    }
    // Menüs pro Drehtag und Unit: Catering-Rolle und Admins
    match /menus/{date} {
      allow read: if crew();
      allow write: if (isAdmin() || isCatering()) && isDate(date)
        && (request.resource == null || (only(['u1', 'u2', 'u3', 'u1a', 'u1b', 'u2a', 'u2b', 'u3a', 'u3b', 'tog', 'zw', 'by', 'at'])
          && short('zw') && short('u1a') && short('u1b') && short('u2a') && short('u2b') && short('u3a') && short('u3b')));
    }

    // ---------- Fahrten aus dem Callsheet ----------
    // Quittieren (Stand s: 1 = Fahrt beginnt, 2 = ausgeführt): alle Mitglieder – die App zeigt den Knopf nur Fahrer:in, «Fahrten quittieren» und «Fahrten Manager»
    match /rideack/{id} {
      allow read: if crew();
      allow create, update: if crew() && rideOk(id, ['d', 'at', 's']) && request.resource.data.get('s', 2) in [1, 2];
      allow delete: if crew();
    }
    // Ändern (Zeiten, Strecke, Fahrer, Mitfahrende; Inhalt c verschlüsselt): nur «Fahrten Manager»
    match /rideedit/{id} {
      allow read: if crew();
      allow create, update: if can('rides.manage') && rideOk(id, ['c', 'd', 'at']) && cOk(8000);
      allow delete: if can('rides.manage');
    }

    // ---------- Szenen aus dem Drehplan (Quittierung, auch Lunch und Wrap) ----------
    // Quittieren (Stand s: 1 = Szene läuft, 2 = abgeschlossen): lesen alle aus der Crew, setzen nur mit «Szenen quittieren» (scenes.ack);
    // Dokument-ID = Datum JJJJMMTT-Szene (keine Namen), Felder: Datum d, Zeitpunkt at, Stand s, Unit u, Szene sc, Beginn b, Ende e (ms)
    match /sceneack/{id} {
      allow read: if crew();
      allow create, update: if can('scenes.ack') && id.matches('[0-9]{8}-[a-z0-9]{1,24}') && only(['d', 'at', 's', 'u', 'sc', 'b', 'e'])
        && isDate(request.resource.data.d) && nearNow(request.resource.data.at) && request.resource.data.s in [1, 2]
        && request.resource.data.get('u', '1') in ['1', '2', '3'] && request.resource.data.get('sc', '') is string && request.resource.data.get('sc', '').size() <= 24
        && request.resource.data.get('b', 0) is int && request.resource.data.get('e', 0) is int
        && id.matches(request.resource.data.d.replace('-', '') + '-.*');
      allow delete: if can('scenes.ack');
    }

    // ---------- Coverday (ganze Drehtage tauschen/verschieben/nachrücken) ----------
    // ein Dokument coverday/state, Inhalt c verschlüsselt; lesen die Crew, ändern nur mit «Coverday verwalten»
    match /coverday/{doc} {
      allow read: if crew();
      allow write: if can('coverday.manage') && doc == 'state' && only(['c', 'at']) && cOk(60000) && request.resource.data.at is int;
    }

    // ---------- Protokoll ----------
    // eigene Verwaltungs-Änderungen mit Serverzeit; lesen Admins oder «Protokoll sehen»; nicht änderbar
    match /audit/{id} {
      allow create: if verified() && crew()
        && only(['by', 'at', 'op', 'col', 'id', 'sum'])
        && request.resource.data.by == myEmail()
        && request.resource.data.at == request.time   // Zeit vom Server, nicht frei wählbar
        && request.resource.data.op in ['set', 'update', 'delete', 'add', 'error']
        && request.resource.data.col in ['roles', 'userroles', 'admins', 'owners', 'invites', 'members', 'menus', 'config', 'broadcasts', 'starts', 'requests', 'app', 'sceneack', 'coverday']
        && request.resource.data.sum is string && request.resource.data.sum.size() <= 300
        && request.resource.data.id is string && request.resource.data.id.size() <= 120;
      allow read: if isAdmin() || can('audit.view');
      allow update: if false;
      allow delete: if isOwner();
    }

    // ---------- alles andere: gesperrt ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
